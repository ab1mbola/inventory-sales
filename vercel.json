{
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/",
      "framework": "vite"
    },
    "backend": {
      "entrypoint": "backend/dist/index.js",
      "routePrefix": "/_/backend",
      "includeFiles": ["package.json"]
    }
  },
  "crons": [
    {
      "path": "/_/backend/api/cron/keep-alive",
      "schedule": "0 0 * * *"
    }
  ]
}
